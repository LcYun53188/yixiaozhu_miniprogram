<view class="page">
  <view class="hero">
    <view class="hero-title">后台管理</view>
    <view class="hero-subtitle">审核发布内容、查看平台数据，并触发匹配推荐。</view>
  </view>

  <view class="section grid">
    <view class="grid-item">用户 {{summary.userCount || 0}}</view>
    <view class="grid-item">待审核 {{summary.pendingReviewCount || 0}}</view>
    <view class="grid-item">资源 {{summary.resourceCount || 0}}</view>
    <view class="grid-item">匹配 {{summary.matchCount || 0}}</view>
  </view>

  <view class="section">
    <view class="section-title">待审核列表</view>
    <view class="card" wx:for="{{reviews}}" wx:key="id">
      <view class="card-title">{{item.title}}</view>
      <view class="muted">{{item.targetTypeText}} · {{item.category}} · 风险：{{item.aiRiskLevelText}}</view>
      <view class="section">{{item.description}}</view>
      <view class="button" bindtap="passReview" data-type="{{item.targetType}}" data-id="{{item.id}}">通过并匹配</view>
      <view class="button secondary" bindtap="rejectReview" data-type="{{item.targetType}}" data-id="{{item.id}}">驳回</view>
    </view>
    <view class="muted" wx:if="{{!reviews.length}}">暂无待审核内容。</view>
  </view>
</view>
