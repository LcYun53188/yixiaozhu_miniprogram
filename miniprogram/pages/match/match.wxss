.card-title {
  line-height: 1.5;
}

.action-row {
  display: flex;
  gap: 14rpx;
  margin-top: 20rpx;
}

.mini-button {
  flex: 1;
  padding: 16rpx;
  border-radius: 16rpx;
  background: linear-gradient(145deg, #e0f2f1, #b2dfdb);
  color: #102027;
  font-size: 24rpx;
  font-weight: 800;
  text-align: center;
}

.mini-button.primary {
  background: linear-gradient(145deg, #ffb300, #ff8f00);
  color: #fff;
}

.feedback-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx;
  background: rgba(16, 32, 39, 0.26);
}

.rating-row {
  margin: 24rpx 0;
}

.rating-star {
  margin-right: 14rpx;
  color: #c8cec8;
  font-size: 48rpx;
}

.rating-star.active {
  color: #f2b84b;
}
