.search-input {
  display: block;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 999rpx;
  background: #f4f8f8;
  box-shadow:
    inset 0 8rpx 20rpx rgba(16, 32, 39, 0.1),
    inset 0 -2rpx 0 rgba(255, 255, 255, 0.88);
}

.category-scroll {
  display: flex;
  gap: 14rpx;
  overflow-x: auto;
  padding: 6rpx 0 18rpx;
  white-space: nowrap;
}

.category-chip {
  flex: 0 0 auto;
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  background: linear-gradient(145deg, #ffffff, #e8f3f4);
  color: #212121;
  font-weight: 800;
  box-shadow: 0 12rpx 24rpx rgba(16, 32, 39, 0.12);
}

.category-chip.active {
  background: linear-gradient(145deg, #ffb300, #ff8f00);
  color: #fff;
}

.type-switch {
  display: flex;
  padding: 8rpx;
  margin-bottom: 18rpx;
  border-radius: 24rpx;
  background: #f4f8f8;
  box-shadow: inset 0 8rpx 20rpx rgba(16, 32, 39, 0.1);
}

.switch-item {
  flex: 1;
  padding: 18rpx;
  border-radius: 18rpx;
  color: #607d8b;
  text-align: center;
  font-weight: 800;
}

.switch-item.active {
  background: linear-gradient(145deg, #102027, #203a43);
  color: #fff;
  box-shadow: 0 12rpx 24rpx rgba(16, 32, 39, 0.22);
}
