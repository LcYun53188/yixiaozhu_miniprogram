<view class="page">
  <view class="section-title">分类浏览</view>
  <view class="category-scroll">
    <view class="category-chip {{category === item.value ? 'active' : ''}}" wx:for="{{categories}}" wx:key="value" bindtap="selectCategory" data-category="{{item.value}}">{{item.label}}</view>
  </view>
  <view class="type-switch">
    <view class="switch-item {{activeType === 'resource' ? 'active' : ''}}" bindtap="switchType" data-type="resource">资源</view>
    <view class="switch-item {{activeType === 'need' ? 'active' : ''}}" bindtap="switchType" data-type="need">需求</view>
  </view>
  <input class="input search-input" placeholder-class="input-placeholder" placeholder="在当前分类中搜索" value="{{keyword}}" bindinput="onKeyword" confirm-type="search" bindconfirm="loadData" />

  <view class="section" wx:if="{{activeType === 'resource'}}">
    <view class="section-title">资源</view>
    <view class="card" wx:for="{{resources}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}" data-type="resource">
      <view class="card-title">{{item.title}}</view>
      <view class="muted">{{item.category}} · {{item.reviewStatusText}}</view>
    </view>
  </view>

  <view class="section" wx:if="{{activeType === 'need'}}">
    <view class="section-title">需求</view>
    <view class="card" wx:for="{{needs}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}" data-type="need">
      <view class="card-title">{{item.title}}</view>
      <view class="muted">{{item.category}} · {{item.reviewStatusText}}</view>
    </view>
  </view>
</view>
