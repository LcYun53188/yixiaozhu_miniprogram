<view class="page">
  <view class="publish-header">
    <view class="publish-title">发布信息</view>
    <view class="publish-subtitle">选择发布类型，填写必要信息后提交审核。</view>
  </view>

  <view class="section">
    <view class="type-selector">
      <text class="type-pill {{type === 'resource' ? 'active' : ''}}" bindtap="setType" data-type="resource">我有资源</text>
      <text class="type-pill {{type === 'need' ? 'active' : ''}}" bindtap="setType" data-type="need">我需要资源</text>
    </view>
    <view class="recognize-box">
      <view class="recognize-header" bindtap="toggleRecognizeMenu">
        <view>
          <view class="card-title">使用智能识别</view>
          <view class="muted">扫码 ISBN 或拍照识别物品，结果可手动修改</view>
        </view>
        <view class="recognize-arrow">{{recognizeMenuOpen ? '收起' : '展开'}}</view>
      </view>
      <view class="smart-tools" wx:if="{{recognizeMenuOpen}}">
        <view class="smart-tool" bindtap="scanIsbn">扫码识别ISBN</view>
        <view class="smart-tool" bindtap="recognizeByCamera">相机识别物品</view>
        <view class="smart-tool" bindtap="recognizeByAlbum">上传图片识别</view>
      </view>
    </view>
    <input class="input form-input" placeholder-class="input-placeholder" placeholder="标题" value="{{form.title}}" data-field="title" bindinput="onInput" />
    <picker range="{{categories}}" bindchange="onCategory">
      <view class="picker">分类：{{form.category || '请选择'}}</view>
    </picker>
    <view class="image-panel">
      <view class="image-list">
        <view class="image-item" wx:for="{{form.imageUrls}}" wx:key="*this">
          <image class="preview-image" src="{{item}}" mode="aspectFill" bindtap="previewImage" data-url="{{item}}" />
          <view class="remove-image" bindtap="removeImage" data-index="{{index}}">删除</view>
        </view>
        <view class="add-image" wx:if="{{form.imageUrls.length < 3}}" bindtap="chooseImages">
          <view class="add-plus">+</view>
          <view class="muted">添加图片</view>
        </view>
      </view>
      <view class="muted">最多添加 3 张图片，用于展示物品、失物或活动信息。</view>
    </view>
    <textarea class="textarea" placeholder="描述物品状态、需求原因、对接地点等" value="{{form.description}}" data-field="description" bindinput="onInput" />
    <input class="input form-input" placeholder-class="input-placeholder" placeholder="联系方式，如手机号 / 微信号" value="{{form.contactInfo}}" data-field="contactInfo" bindinput="onInput" />
    <input class="input form-input" placeholder-class="input-placeholder" placeholder="交接地点，如图书馆门口" value="{{form.locationText}}" data-field="locationText" bindinput="onInput" wx:if="{{type === 'resource'}}" />
  </view>

  <view class="section">
    <view class="section-title">AI 辅助</view>
    <view class="button secondary" bindtap="extractTags">智能提取标签</view>
    <view class="button secondary" bindtap="polishText">优化描述</view>
    <view class="card" wx:if="{{form.tags.length || form.polishedText || assistTip}}">
      <view class="muted">AI 结果，可手动删改</view>
      <view class="editable-tags">
        <view class="editable-tag" wx:for="{{form.tags}}" wx:key="*this">
          <text>{{item}}</text>
          <text class="tag-remove" bindtap="removeTag" data-index="{{index}}">×</text>
        </view>
      </view>
      <view class="tag-editor">
        <input class="input tag-input" placeholder-class="input-placeholder" placeholder="手动添加标签" value="{{newTag}}" bindinput="onNewTagInput" />
        <view class="tag-add" bindtap="addTag">添加</view>
      </view>
      <view class="muted">{{form.polishedText}}</view>
      <view class="muted" wx:if="{{assistTip}}">{{assistTip}}</view>
    </view>
  </view>

  <view class="button" bindtap="submit">确认发布</view>
</view>
