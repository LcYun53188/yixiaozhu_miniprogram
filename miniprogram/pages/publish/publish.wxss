.button.secondary {
  margin-right: 12rpx;
}

.form-input {
  display: block;
  height: 92rpx;
  line-height: 92rpx;
}

.image-panel {
  margin-top: 18rpx;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.image-item,
.add-image {
  position: relative;
  width: 190rpx;
  height: 190rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #fffdf7;
  border: 2rpx dashed #bfd2bf;
}

.preview-image {
  width: 100%;
  height: 100%;
}

.remove-image {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 8rpx 0;
  background: rgba(34, 53, 45, 0.72);
  color: #fff;
  font-size: 22rpx;
  text-align: center;
}

.add-image {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.add-plus {
  color: #2f7d5c;
  font-size: 58rpx;
  line-height: 1;
  font-weight: 300;
}
