.button.secondary {
  margin-right: 12rpx;
}

.publish-header {
  padding: 24rpx 26rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #102027, #203a43);
  box-shadow: 0 18rpx 38rpx rgba(16, 32, 39, 0.2);
}

.publish-title {
  color: #fff;
  font-size: 36rpx;
  font-weight: 900;
}

.publish-subtitle {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
}

.type-selector {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.type-pill {
  padding: 28rpx 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(145deg, #ffffff, #e8f3f4);
  color: #212121;
  font-size: 32rpx;
  font-weight: 800;
  text-align: center;
  box-shadow: 0 12rpx 22rpx rgba(16, 32, 39, 0.12);
}

.type-pill.active {
  background: linear-gradient(145deg, #ffb300, #ff8f00);
  color: #fff;
  box-shadow:
    0 14rpx 28rpx rgba(255, 143, 0, 0.32),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.35);
}

.form-input {
  display: block;
  height: 92rpx;
  line-height: 92rpx;
}

.smart-tools {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 18rpx;
}

.recognize-box {
  margin-top: 20rpx;
  padding: 22rpx;
  border-radius: 26rpx;
  background: #f4f8f8;
  box-shadow:
    inset 0 8rpx 24rpx rgba(16, 32, 39, 0.08),
    0 14rpx 28rpx rgba(16, 32, 39, 0.08);
}

.recognize-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.recognize-arrow {
  color: #ff8f00;
  font-weight: 800;
  font-size: 24rpx;
}

.smart-tool {
  padding: 18rpx 10rpx;
  border-radius: 18rpx;
  background:
    radial-gradient(circle at 22% 18%, rgba(79, 195, 247, 0.46), transparent 34%),
    linear-gradient(145deg, #102027, #1c3c48);
  color: #ffffff;
  font-weight: 800;
  font-size: 24rpx;
  text-align: center;
  box-shadow:
    0 16rpx 32rpx rgba(16, 32, 39, 0.24),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.16);
}

.image-panel {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 24rpx;
  background: #f4f8f8;
  box-shadow:
    inset 0 8rpx 24rpx rgba(16, 32, 39, 0.08),
    inset 0 -2rpx 0 rgba(255, 255, 255, 0.9);
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.image-item,
.add-image {
  position: relative;
  width: 190rpx;
  height: 190rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #fffdf7;
  border: 2rpx dashed #90a4ae;
  box-shadow: 0 10rpx 24rpx rgba(16, 32, 39, 0.12);
}

.preview-image {
  width: 100%;
  height: 100%;
}

.remove-image {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 8rpx 0;
  background: rgba(34, 53, 45, 0.72);
  color: #fff;
  font-size: 22rpx;
  text-align: center;
}

.add-image {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.add-plus {
  color: #2f7d5c;
  font-size: 58rpx;
  line-height: 1;
  font-weight: 300;
}

.editable-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.editable-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: linear-gradient(145deg, #fff8e1, #ffe0b2);
  color: #4e342e;
  font-size: 22rpx;
  box-shadow: 0 8rpx 18rpx rgba(255, 143, 0, 0.16);
}

.tag-remove {
  font-size: 28rpx;
  line-height: 1;
  color: #b8512f;
}

.tag-editor {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
  align-items: center;
}

.tag-input {
  flex: 1;
  margin-top: 0;
}

.tag-add {
  width: 120rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 18rpx;
  background: linear-gradient(145deg, #ffb300, #ff8f00);
  color: #fff;
  font-weight: 800;
  text-align: center;
}
