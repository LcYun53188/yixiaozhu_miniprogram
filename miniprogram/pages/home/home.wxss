.notice-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  height: 92rpx;
  padding: 0 24rpx;
  border-radius: 26rpx;
  background:
    radial-gradient(circle at 8% 30%, rgba(255, 143, 0, 0.28), transparent 36%),
    linear-gradient(135deg, #102027, #203a43);
  box-shadow: 0 20rpx 42rpx rgba(16, 32, 39, 0.22);
}

.notice-label {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: linear-gradient(145deg, #ffb300, #ff8f00);
  color: #fff;
  font-size: 22rpx;
  font-weight: 800;
}

.notice-swiper {
  flex: 1;
  height: 92rpx;
}

.notice-text {
  height: 92rpx;
  line-height: 92rpx;
  color: rgba(255, 255, 255, 0.92);
  font-size: 25rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.grid-item:nth-child(1),
.grid-item:nth-child(4) {
  background: linear-gradient(145deg, #e0f2f1, #b2dfdb);
}

.grid-item:nth-child(2),
.grid-item:nth-child(5) {
  background: linear-gradient(145deg, #fff8e1, #ffe0b2);
}

.grid-item:nth-child(3),
.grid-item:nth-child(6) {
  background: linear-gradient(145deg, #e3f2fd, #bbdefb);
}
