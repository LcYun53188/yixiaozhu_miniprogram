<view class="page">
  <view class="notice-card">
    <view class="notice-label">公告</view>
    <swiper class="notice-swiper" vertical autoplay circular interval="2800">
      <swiper-item wx:for="{{notices}}" wx:key="*this">
        <view class="notice-text">{{item}}</view>
      </swiper-item>
    </swiper>
  </view>

  <view class="section">
    <view class="section-title">分类入口</view>
    <view class="grid">
      <view class="grid-item" wx:for="{{categories}}" wx:key="*this" bindtap="goCategory" data-category="{{item}}">{{item}}</view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">推荐资源</view>
    <view class="card" wx:for="{{resources}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}" data-type="resource">
      <view class="card-title">{{item.title}}</view>
      <view class="muted">{{item.category}} · {{item.flowStatusText}}</view>
      <view class="tags">
        <text class="tag" wx:for="{{item.tags}}" wx:key="*this">{{item}}</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">最新需求</view>
    <view class="card" wx:for="{{needs}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}" data-type="need">
      <view class="card-title">{{item.title}}</view>
      <view class="muted">{{item.category}} · 紧急程度 {{item.urgencyLevelText}}</view>
    </view>
  </view>
</view>
