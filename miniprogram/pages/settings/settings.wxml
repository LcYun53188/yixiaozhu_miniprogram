<view class="page">
  <view class="hero">
    <view class="hero-title">个人设置</view>
    <view class="hero-subtitle">完善个人信息，或使用一次性邀请码申请管理员权限。</view>
  </view>

  <view class="section">
    <view class="section-title">账号信息</view>
    <view class="card">
      <view>昵称：{{user.nickname || '微信用户'}}</view>
      <view>身份：{{user.roleText || '普通用户'}}</view>
      <view>学院：{{user.college || '未填写'}}</view>
      <view>验证状态：{{user.identityVerified ? '已验证' : '未验证'}}</view>
      <view>信誉积分：{{user.creditScore || 100}}</view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">学号姓名验证</view>
    <view class="card">
      <input class="input" placeholder-class="input-placeholder" placeholder="请输入学号" value="{{identityForm.studentNo}}" data-field="studentNo" bindinput="onIdentityInput" />
      <input class="input" placeholder-class="input-placeholder" placeholder="请输入真实姓名" value="{{identityForm.realName}}" data-field="realName" bindinput="onIdentityInput" />
      <input class="input" placeholder-class="input-placeholder" placeholder="请输入学院，可选" value="{{identityForm.college}}" data-field="college" bindinput="onIdentityInput" />
      <view class="button" bindtap="verifyIdentity">提交验证</view>
      <view class="muted">完成验证后才可发布资源/需求、使用管理员邀请码等关键功能。</view>
    </view>
  </view>

  <view class="section" wx:if="{{user.role !== 'admin' && user.role !== 'super_admin'}}">
    <view class="section-title">管理员邀请码</view>
    <view class="card">
      <input class="input" placeholder-class="input-placeholder" placeholder="请输入一次性管理员邀请码" value="{{adminInviteCode}}" bindinput="onAdminInviteInput" />
      <view class="button" bindtap="redeemAdminInvite">使用邀请码成为管理员</view>
      <view class="muted">邀请码只能使用一次。验证成功后，当前账号将获得后台管理权限。</view>
    </view>
  </view>

  <view class="section" wx:else>
    <view class="card">
      <view class="card-title">管理员权限已开通</view>
      <view class="muted">你当前已拥有后台管理权限，可返回“我的”页面进入后台管理。</view>
    </view>
  </view>
</view>
