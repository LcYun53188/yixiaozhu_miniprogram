page {
  min-height: 100vh;
  background: #f5f7ef;
  color: #22352d;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page {
  padding: 28rpx;
}

.hero {
  padding: 36rpx 32rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #2f7d5c, #7fb069);
  color: #fffdf7;
  box-shadow: 0 18rpx 40rpx rgba(47, 125, 92, 0.18);
}

.hero-title {
  font-size: 46rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.hero-subtitle {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.7;
  opacity: 0.92;
}

.section {
  margin-top: 28rpx;
}

.section-title {
  margin-bottom: 18rpx;
  font-size: 32rpx;
  font-weight: 800;
}

.card {
  margin-bottom: 18rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #fffdf7;
  box-shadow: 0 10rpx 30rpx rgba(34, 53, 45, 0.08);
}

.card-title {
  font-size: 30rpx;
  font-weight: 750;
}

.muted {
  color: #77847b;
  font-size: 24rpx;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.tag {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #e8f2df;
  color: #2f7d5c;
  font-size: 22rpx;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.grid-item {
  padding: 24rpx;
  border-radius: 22rpx;
  background: #fffdf7;
  font-weight: 700;
  text-align: center;
  box-shadow: 0 10rpx 26rpx rgba(34, 53, 45, 0.07);
}

.input,
.textarea,
.picker {
  box-sizing: border-box;
  width: 100%;
  margin-top: 12rpx;
  border-radius: 18rpx;
  background: #fffdf7;
  border: 2rpx solid #e4eadf;
  color: #22352d;
  font-size: 28rpx;
}

.input {
  height: 88rpx;
  min-height: 88rpx;
  padding: 0 24rpx;
  line-height: 88rpx;
}

.input-placeholder {
  color: #9aa59d;
  font-size: 28rpx;
  line-height: 88rpx;
}

.picker {
  min-height: 88rpx;
  padding: 0 24rpx;
  line-height: 88rpx;
}

.textarea {
  min-height: 180rpx;
  padding: 22rpx 24rpx;
  line-height: 1.6;
}

.button {
  margin-top: 22rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: #2f7d5c;
  color: #fff;
  text-align: center;
  font-weight: 800;
}

.button.secondary {
  background: #f2b84b;
  color: #3d2d12;
}
