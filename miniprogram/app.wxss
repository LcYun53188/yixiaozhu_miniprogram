page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f6fafb 0%, #eef3f4 48%, #fff8e1 100%);
  color: #212121;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page {
  padding: 28rpx;
}

.hero {
  padding: 40rpx 34rpx;
  border-radius: 32rpx;
  background:
    radial-gradient(circle at 18% 18%, rgba(255, 143, 0, 0.26), transparent 32%),
    linear-gradient(135deg, #102027 0%, #203a43 54%, #2c5364 100%);
  color: #ffffff;
  box-shadow: 0 24rpx 54rpx rgba(16, 32, 39, 0.28);
}

.hero-title {
  font-size: 46rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.hero-subtitle {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.88);
}

.section {
  margin-top: 28rpx;
}

.section-title {
  margin-bottom: 18rpx;
  font-size: 32rpx;
  font-weight: 800;
  color: #212121;
}

.card {
  margin-bottom: 18rpx;
  padding: 26rpx;
  border-radius: 24rpx;
  background: linear-gradient(145deg, #ffffff 0%, #f8fbfb 100%);
  border: 2rpx solid rgba(255, 255, 255, 0.78);
  box-shadow:
    0 20rpx 42rpx rgba(16, 32, 39, 0.14),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.85);
}

.card-title {
  font-size: 30rpx;
  font-weight: 750;
  color: #212121;
}

.muted {
  color: #757575;
  font-size: 24rpx;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.tag {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: linear-gradient(145deg, #fff8e1, #ffe0b2);
  color: #4e342e;
  font-size: 22rpx;
  box-shadow: 0 8rpx 18rpx rgba(255, 143, 0, 0.12);
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.grid-item {
  padding: 26rpx;
  border-radius: 22rpx;
  background: linear-gradient(145deg, #ffffff, #e9f5f5);
  color: #212121;
  font-weight: 700;
  text-align: center;
  box-shadow:
    0 18rpx 34rpx rgba(16, 32, 39, 0.13),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.9);
}

.input,
.textarea,
.picker {
  box-sizing: border-box;
  width: 100%;
  margin-top: 12rpx;
  border-radius: 18rpx;
  background: #f7fbfb;
  border: 2rpx solid #d7e5e6;
  color: #212121;
  font-size: 28rpx;
  box-shadow:
    inset 0 6rpx 16rpx rgba(16, 32, 39, 0.08),
    inset 0 -2rpx 0 rgba(255, 255, 255, 0.85);
}

.input {
  height: 88rpx;
  min-height: 88rpx;
  padding: 0 24rpx;
  line-height: 88rpx;
}

.input-placeholder {
  color: #8a9aa0;
  font-size: 28rpx;
  line-height: 88rpx;
}

.picker {
  min-height: 88rpx;
  padding: 0 24rpx;
  line-height: 88rpx;
}

.textarea {
  min-height: 180rpx;
  padding: 22rpx 24rpx;
  line-height: 1.6;
}

.button {
  margin-top: 22rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: linear-gradient(145deg, #ffb300, #ff8f00);
  color: #fff;
  text-align: center;
  font-weight: 800;
  box-shadow:
    0 16rpx 30rpx rgba(255, 143, 0, 0.3),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.36);
}

.button.secondary {
  background: linear-gradient(145deg, #e0f2f1, #b2dfdb);
  color: #102027;
  box-shadow: 0 14rpx 28rpx rgba(16, 32, 39, 0.14);
}
